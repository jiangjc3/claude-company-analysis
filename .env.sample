# Claude Code 投资分析 Skill — 环境变量模板 (P0: A-share free sources)
#
# ⚠️  不要把真实密钥提交到 git。
# P0 起不再需要 TUSHARE_TOKEN。

# ------------------------------------------------------------
# 可选：缓存目录（默认 ~/.claude/plugins/company-analysis/.cache）
# ------------------------------------------------------------
# export COMPANY_ANALYSIS_CACHE="$HOME/.claude/plugins/company-analysis/.cache"

# ------------------------------------------------------------
# 可选：缓存 TTL（默认 7 天）；增量复查可临时设 0
# ------------------------------------------------------------
# export COMPANY_ANALYSIS_CACHE_TTL=7
# export CA_CACHE_MAX_AGE_DAYS=0

# ------------------------------------------------------------
# 可选：HTTP 超时 / 限速（免费源防封）
# ------------------------------------------------------------
# export CA_HTTP_TIMEOUT=30
# export CA_RATE_LIMIT=0.35
# export CA_HTTP_MAX_RETRIES=4

# 仅 A 股。美股/港股产品路径已移除。
